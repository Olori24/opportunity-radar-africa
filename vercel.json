{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/live",
      "dest": "/index.html"
    },
    {
      "src": "/v1/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/(health|demo/analyze|analyze)",
      "dest": "api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
